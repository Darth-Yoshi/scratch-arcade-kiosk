# Scratch Arcade Kiosk configuration (TOML format)
# Copy this file to config/config and adjust values for your installation.

base_dir = "/home/pi/games"
allowed_extensions = [".sb3"]

[display]
width = 800
height = 480

[idle]
# Return to the root picker after this many seconds of inactivity.
# Set to 0 or remove to disable automatic reset.
idle_return_seconds = 120

[kiosk]
autostart = true

[gpio]
# BCM numbering, e.g. pin 17 corresponds to physical pin 11 on the 40-pin header.
exit_pin = 17
# Debounce interval in milliseconds
# Set to 0 to disable software debouncing (not recommended).
debounce_ms = 150

[gpio.keypad]
# Commands invoked when GPIO key buttons are pressed/released. "{key}" expands
# to the configured key symbol (see `man xdotool` for supported names). The
# optional "{action}" placeholder resolves to "press" or "release" to help when
# wrapping scripts.
press_command = ["xdotool", "keydown", "{key}"]
release_command = ["xdotool", "keyup", "{key}"]

[[gpio.keypad.buttons]]
pin = 5
key = "Up"

[[gpio.keypad.buttons]]
pin = 6
key = "Down"

[[gpio.keypad.buttons]]
pin = 13
key = "Left"

[[gpio.keypad.buttons]]
pin = 19
key = "Right"

[[gpio.keypad.buttons]]
pin = 26
key = "space"

[[gpio.keypad.buttons]]
pin = 16
key = "1"

[[gpio.keypad.buttons]]
pin = 20
key = "2"

[[gpio.keypad.buttons]]
pin = 21
key = "3"

[player]
# Command to launch the Scratch-compatible player. "{file}" expands to the
# raw path; "{file_url}" is a URI version for browsers. The default launches
# TurboWarp Desktop in player mode and forwards autoplay/turbo/fps flags as
# optional CLI switches.
command = [
  "turbowarp-desktop",
  "--player",
  "{file}",
  "--fullscreen",
  "{autoplay_flag}",
  "{turbo_flag}",
  "{fps_flag}",
]
# Optional extra behaviour toggles depending on the player you use.
autoplay = true
# TurboWarp Desktop accepts "--turbo" to accelerate projects when desired.
turbo = false
# TurboWarp Desktop supports "--fps=<n>" to change the frame rate cap.
fps = 60

[ui]
# Optional search box in the picker.
show_search = true
# Maximum number of entries per column before scrolling is required.
max_visible_entries = 6
